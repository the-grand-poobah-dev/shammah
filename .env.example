NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_API_KEY=
GEMINI_API_KEY=
CRON_SECRET=
# If MPESA_CALLBACK_SECRET is set, append ?secret=<MPESA_CALLBACK_SECRET> to this URL.
# Required for any deployed payment environment, including Daraja sandbox testing.
# Use a URL-safe random secret and include it as ?secret=<value> in MPESA_CALLBACK_URL.
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=
# Keep disabled; only enable deliberate payment simulation in local non-production testing.
MPESA_ALLOW_SIMULATION=false
MPESA_CONSUMER_KEY=
# Optional: sandbox (default) or production
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ACCESS_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_DESKTOP_LAYOUT=on

# Optional: Firebase Cloud Messaging HTTP v1 (required for server-sent push reminders).
# Set either FIREBASE_SERVICE_ACCOUNT_JSON or all three fields below.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
NEXT_PUBLIC_SITE_URL=

# Optional Bible text provider. Without these values, KJV and WEB use the public-domain bible-api.com fallback.
API_BIBLE_KEY=
API_BIBLE_KJV_ID=
API_BIBLE_WEB_ID=
# Optional LiveKit Cloud configuration. Without these values, the Live button explains that Live is not configured.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional server-side GIF search provider (keep the API key private; never prefix it with NEXT_PUBLIC_)
GIF_PROVIDER=giphy
GIPHY_API_KEY=
