+
+/* =====================================================================
+   Profile settings page  (/settings)
+   ===================================================================== */
+
+.st-page {
+  min-height: 100vh;
+  padding-bottom: 140px;
+  background:
+    radial-gradient(900px 380px at 8% -90px, color-mix(in srgb, var(--gold) 18%, transparent), transparent 70%),
+    radial-gradient(800px 360px at 100% -70px, color-mix(in srgb, var(--teal) 18%, transparent), transparent 70%),
+    var(--bg);
+  color: var(--ink);
+}
+
+.st-wrap {
+  max-width: 640px;
+  margin: 0 auto;
+  padding: 16px 16px 0;
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
