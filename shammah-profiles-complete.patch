+
+.st-btn-primary {
+  background: linear-gradient(135deg, var(--teal), color-mix(in srgb, var(--teal) 70%, var(--gold)));
+  color: #fff;
+  box-shadow: 0 6px 16px color-mix(in srgb, var(--teal) 30%, transparent);
+}
+
+.st-btn-primary:hover:not(:disabled) {
+  box-shadow: 0 8px 22px color-mix(in srgb, var(--teal) 42%, transparent);
+}
+
+.st-btn-ghost {
+  background: transparent;
+  color: var(--ink);
+  border-color: var(--border);
+}
+
+.st-btn-ghost:hover {
+  border-color: var(--teal);
+  color: var(--teal);
+}
+
+.st-btn-plain {
+  background: transparent;
+  color: var(--ink-muted);
+}
+
+.st-btn-danger {
+  background: var(--rose-soft);
+  color: var(--rose);
+}
+
+/* Save bar */
+
+.st-savebar {
+  position: fixed;
+  left: 50%;
+  bottom: calc(16px + env(safe-area-inset-bottom, 0px));
+  z-index: 40;
+  width: min(calc(100% - 24px), 620px);
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  padding: 10px 10px 10px 18px;
+  border-radius: 999px;
+  background: color-mix(in srgb, var(--surface) 82%, transparent);
+  border: 1px solid var(--border);
+  backdrop-filter: blur(16px);
+  -webkit-backdrop-filter: blur(16px);
+  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.2);
+  transform: translate(-50%, 140%);
+  opacity: 0;
+  pointer-events: none;
+  transition: transform 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.1), opacity 0.25s ease;
+}
+
+.st-savebar.show {
+  transform: translate(-50%, 0);
+  opacity: 1;
+  pointer-events: auto;
+}
+
+.st-savebar-text {
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--ink);
+}
+
+.st-savebar-actions {
+  display: flex;
+  gap: 4px;
+}
+
+.st-savebar .st-btn {
+  padding: 9px 16px;
+}
+
+/* Toast + modal */
+
+.st-toast {
+  position: fixed;
+  top: calc(70px + env(safe-area-inset-top, 0px));
+  left: 50%;
+  transform: translateX(-50%);
+  z-index: 60;
+  max-width: calc(100% - 32px);
+  padding: 12px 18px;
+  border-radius: 14px;
+  font-size: 14px;
+  font-weight: 600;
+  color: #fff;
+  background: var(--teal);
+  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
+  animation: st-drop 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.1);
+}
+
+.st-toast.error {
+  background: var(--rose);
+}
+
+.st-modal-back {
+  position: fixed;
+  inset: 0;
+  z-index: 70;
+  display: grid;
+  place-items: center;
+  padding: 16px;
+  background: rgba(20, 26, 22, 0.55);
+  backdrop-filter: blur(4px);
+  animation: st-fade 0.2s ease;
+}
+
+.st-modal {
+  width: 100%;
+  max-width: 440px;
+  max-height: 90vh;
+  overflow-y: auto;
+  padding: 22px;
+  border-radius: 22px;
+  background: var(--surface);
+  border: 1px solid var(--border);
+  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.3);
+  animation: st-rise 0.3s ease both;
+}
+
+.st-modal-actions {
+  display: flex;
+  justify-content: flex-end;
+  gap: 6px;
+  margin-top: 14px;
+}
+
+/* Loading skeletons */
+
+.st-skeleton {
+  border-radius: 20px;
+  background: linear-gradient(100deg, var(--surface) 30%, var(--border) 50%, var(--surface) 70%);
+  background-size: 200% 100%;
+  animation: st-shimmer 1.4s linear infinite;
+}
+
+.st-skel-hero { height: 300px; }
+.st-skel-card { height: 150px; }
+
+/* Motion */
+
+.st-rise {
+  animation: st-rise 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
+  animation-delay: var(--d, 0ms);
+}
+
+@keyframes st-rise {
+  from { opacity: 0; transform: translateY(14px); }
+  to { opacity: 1; transform: none; }
+}
+@keyframes st-drop {
+  from { opacity: 0; transform: translate(-50%, -12px); }
+  to { opacity: 1; transform: translate(-50%, 0); }
+}
+@keyframes st-fade { from { opacity: 0; } to { opacity: 1; } }
+@keyframes st-spin { to { transform: rotate(360deg); } }
+@keyframes st-shimmer { to { background-position: -200% 0; } }
+
+@media (prefers-reduced-motion: reduce) {
+  .st-rise, .st-toast, .st-modal, .st-modal-back, .st-skeleton, .st-avatar-busy::after {
+    animation: none;
+  }
+  .st-savebar, .st-meter-fill { transition: none; }
+}
+
+[data-theme='dark'] .st-hero,
+[data-theme='dark'] .st-card {
+  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
+}
+
+@media (max-width: 480px) {
+  .st-cover { height: 140px; }
+  .st-name { font-size: 22px; }
+  .st-badge-hero { flex-wrap: wrap; }
+}
